# Managed by Ansible — do not edit by hand.
# Survives suspend/resume hotplug (unlike runtime `xinput set-prop`).
Section "InputClass"
    Identifier "touchpad-natural-scroll"
    MatchIsTouchpad "on"
    Driver "libinput"
    Option "NaturalScrolling" "on"
{% if display_touchpad_tap_click | default(true) %}
    # Two-finger tap = right click, three-finger tap = middle click (lrm map).
    Option "Tapping" "on"
    Option "TappingButtonMap" "lrm"
{% endif %}
{% if display_touchpad_clickfinger | default(false) %}
    # Two-finger physical press = right click, three-finger press = middle.
    Option "ClickMethod" "clickfinger"
{% endif %}
EndSection
