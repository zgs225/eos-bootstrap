# Managed by Ansible — do not edit by hand.
# Overrides /usr/lib/tmpfiles.d/tmp.conf wholesale, so the vendor's age-based
# rules are restated here. D! runs at boot only, which keeps the daily
# systemd-tmpfiles --clean run from emptying /tmp under a running system; the
# D line covers long uptimes, where boot clearing never happens.
D! /tmp 1777 root root 0
D /tmp 1777 root root 10d
D /var/tmp 1777 root root 30d
