# Rendered by eos-bootstrap (ansible/roles/packages/tasks/arto.yml) from the
# upstream GitHub release API: pkgver and sha256sums come from the API, so
# there is no version to bump here. Edit this template, not the copy in
# {{ arto_build_dir }}/.
#
# Upstream ships .deb/.AppImage/bare binary for Linux only — no pacman package
# and no AUR entry. This PKGBUILD repacks the .deb and fixes two things it
# gets wrong for a pacman system: the shipped .desktop has no MimeType (so
# nothing registers Arto as a Markdown handler) and it carries an empty
# /usr/lib/Arto directory.

pkgname=arto-bin
pkgver={{ arto_ver }}
pkgrel=1
pkgdesc='A GitHub Markdown viewer that renders locally and offline (prebuilt upstream release)'
arch=('{{ arto_arch }}')
url='https://arto-app.github.io'
license=('MIT')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'libsoup3'
  'glib2'
  'glibc'
  'gcc-libs'
  'openssl'
  'cairo'
  'pango'
  'gdk-pixbuf2'
  'libxcb'
  'libxdo3'   # AUR: upstream links against libxdo.so.3, repo xdotool only ships .so.4
)
provides=('arto')
conflicts=('arto')
options=('!strip')  # release binary is already stripped; stripping again is wasted time

_debfile="arto_${pkgver}_{{ arto_deb_arch }}.deb"

source=(
  "${_debfile}::https://github.com/arto-app/Arto/releases/download/v${pkgver}/${_debfile}"
  "LICENSE::https://raw.githubusercontent.com/arto-app/Arto/v${pkgver}/LICENSE"
)
sha256sums=('{{ arto_deb_sha }}'
            'SKIP')

package() {
  cd "${srcdir}"

  # .deb = ar archive of debian-binary + control.tar.gz + data.tar.gz
  ar x "${_debfile}"
  bsdtar xf data.tar.gz -C "${pkgdir}" --no-same-owner

  # Drop the empty Debian-only directory.
  rmdir "${pkgdir}/usr/lib/Arto" 2>/dev/null || true

  install -Dm644 "${srcdir}/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

  # Upstream's .desktop declares no MimeType, so nothing on Linux registers it
  # as a handler for Markdown. Add it here so xdg-mime / file managers see it.
  sed -i 's|^Icon=arto$|Icon=arto\nMimeType=text/markdown;|' \
    "${pkgdir}/usr/share/applications/arto.desktop"
  sed -i 's|^Categories=.*|Categories=Utility;TextTools;Viewer;|' \
    "${pkgdir}/usr/share/applications/arto.desktop"
}
