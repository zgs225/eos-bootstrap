# {{ ansible_managed }}
# Per-app overrides live in ~/.config/keyd/app.conf (dotfiles repo), not here.
# rightalt=layer(alt) overrides upstream altgr; AltGr character entry will not work (fcitx5 handles CJK).

[ids]
*

[main]
leftalt  = layer(alt)
rightalt = layer(alt)

[alt]
c = C-c
v = C-v
x = C-x
a = C-a
w = C-w
t = C-t
z = C-z
s = C-s
# [ / ] also exist in [alt+shift]; without explicit bindings keyd intermittently swallows Alt+[ / Alt+].
[ = A-[
] = A-]

[alt+shift]
v = A-S-v
c = A-S-c
leftbrace  = A-S-[
rightbrace = A-S-]
l = A-S-l
