#!/usr/bin/env bash
# lid-watchdog — debounced lid-close suspend.
#
# Why this exists: the lid switch on this laptop (ASUS VivoBook N7600ZE,
# ACPI PNP0C0D) intermittently reports "closed" while the lid is
# physically open. With the stock logind HandleLidSwitch=suspend, every
# spurious pulse drops the machine into s2idle mid-work: screen goes
# black, and on resume the i915 GuC/HuC firmware reload prints boot-like
# text to the console. Observed 2026-08-10: five false triggers in one
# day, pulses lasting <1s to ~50s.
#
# logind's lid handling is disabled (see 10-lid-debounce.conf in
# /etc/systemd/logind.conf.d/). This service is then the single
# suspend-on-lid-close path: it polls the ACPI lid state and only runs
# systemctl suspend after the state has read "closed" continuously for
# DEBOUNCE_SECS, which filters the short spurious pulses. Every state
# transition is logged so pulse durations stay measurable and the
# threshold can be tuned.
#
# If pulses longer than DEBOUNCE_SECS keep occurring (or the sensor
# sticks closed), software cannot distinguish them from a real lid
# close — that points at the sensor/switch hardware and needs an RMA.
#
# Implementation note (2026-08-26): the loop is pure bash — no subshells,
# no external commands per iteration. The timer is `read -t` blocked on a
# pipe that never delivers data (timer fd 9, fed by `tail -f /dev/null`,
# which exits via --pid=$$ when the watchdog dies, even on SIGKILL), and
# the clock is printf's builtin epoch format; the original sed/date/sleep
# version forked three processes per poll and measured ~27 min CPU/day
# (~1.8% of a core, 25 h service instance). Current cost is ~0.4% of a
# core; on this laptop the residual is dominated by the per-poll /proc
# open + bash interpreter overhead.
#
# Overridable via env for testing: LID_STATE_FILE, SUSPEND_CMD,
# DEBOUNCE_SECS, POLL_INTERVAL.
set -u

LID_STATE_FILE="${LID_STATE_FILE:-/proc/acpi/button/lid/LID/state}"
SUSPEND_CMD="${SUSPEND_CMD:-systemctl suspend}"
DEBOUNCE_SECS="${DEBOUNCE_SECS:-10}"
POLL_INTERVAL="${POLL_INTERVAL:-1}"

log() { logger -t lid-watchdog "$*"; }

# Timer fd: tail never writes to the pipe, so `read -rt` below always
# blocks for POLL_INTERVAL and times out (rc 142) — a fork-free sleep.
exec 9< <(tail --pid=$$ -f /dev/null)

last_state=""
closed_since=0
line=""
now=0

while :; do
    # Read the ACPI lid state with bash builtins only: the file redirect
    # and [[ =~ ]] regex avoid the sed subshell the old version forked
    # every poll. "" / unreadable file degrades to "unknown" (never
    # treated as closed, so a wedged file can't suspend the machine).
    state="unknown"
    if IFS= read -r line < "$LID_STATE_FILE" 2>/dev/null \
        && [[ $line =~ ^state:[[:space:]]*(closed|open)[[:space:]]*$ ]]; then
        state="${BASH_REMATCH[1]}"
    fi

    if [[ $state != "$last_state" ]]; then
        log "lid state: $state"
        last_state="$state"
    fi

    # Epoch seconds via bash's printf date builtin — no date(1) fork.
    printf -v now '%(%s)T' -1

    if [[ $state == closed ]]; then
        if (( closed_since == 0 )); then
            closed_since=$now
        elif (( now - closed_since >= DEBOUNCE_SECS )); then
            log "lid closed for >= ${DEBOUNCE_SECS}s, suspending"
            # shellcheck disable=SC2086 # SUSPEND_CMD is an env-overridable command line
            $SUSPEND_CMD || log "suspend command failed (rc=$?)"
            # After a failed suspend the lid is still closed: restart the
            # debounce so the next attempt fires in another DEBOUNCE_SECS.
            closed_since=0
        fi
    else
        closed_since=0
    fi

    # Fork-free sleep: blocks POLL_INTERVAL then times out (rc 142).
    read -rt "$POLL_INTERVAL" -u 9 2>/dev/null || true
done